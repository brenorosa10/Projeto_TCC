# Cole este bloco no Caddyfile do ScoreHistory (o Caddy que já escuta 80/443).
# Crie o DNS A/CNAME de ASTRO_ADDRESS para o mesmo IP da VPS.
#
# No .env do ScoreHistory:
#   ASTRO_ADDRESS=astro.seudominio.com
#
# Uma vez na VPS:
#   docker network create proxy

{$ASTRO_ADDRESS} {
	reverse_proxy astro-frontend:80
}
