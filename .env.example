# URL pública do Astro (HTTPS). O frontend chama /api no mesmo domínio.
Auth__FrontendUrl=https://astroarq.online
Cors__Origins=https://astroarq.online

# Deixe vazio em produção: o nginx do container faz proxy de /api, /hubs e /signin-google.
VITE_API_URL=

ConnectionStrings__MongoDb=mongodb+srv://USER:PASSWORD@cluster/astro?appName=Astro

Auth__Google__ClientId=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
# Cole o secret real do cliente Web (começa com GOCSPX-). Sem aspas, sem prefixo YOUR_.
Auth__Google__ClientSecret=GOCSPX-cole_o_secret_aqui
Auth__Jwt__Key=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Auth__Jwt__Issuer=Astro.Api
Auth__Jwt__Audience=Astro.Frontend

# Chave gratuita do Google AI Studio (https://aistudio.google.com/apikey). Sem aspas.
# Se ficar vazia, o botão de gerar questões mostra um aviso e o resto do app segue normal.
GEMINI_API_KEY=
# Opcional. Padrão: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
